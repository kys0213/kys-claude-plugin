{
  "roles": {
    "source": [
      "**/*.java"
    ],
    "config": [
      "**/*Config.java",
      "**/*Configuration.java",
      "**/*Properties.java",
      "**/config/**/*.java"
    ],
    "boundary": [
      "**/*Client.java",
      "**/*Adapter.java",
      "**/*Repository.java",
      "**/*Controller.java",
      "**/*Handler.java",
      "**/*Interceptor.java",
      "**/*Filter.java",
      "**/*Middleware.java"
    ],
    "test": [
      "**/src/test/**/*.java",
      "**/*Test.java",
      "**/*Tests.java",
      "**/*IT.java"
    ]
  }
}
