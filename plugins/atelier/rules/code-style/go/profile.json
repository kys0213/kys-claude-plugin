{
  "roles": {
    "source": [
      "**/*.go"
    ],
    "config": [
      "**/config.go",
      "**/options.go",
      "**/config/**/*.go"
    ],
    "boundary": [
      "**/*_client.go",
      "**/*_adapter.go",
      "**/*_repository.go",
      "**/*_handler.go",
      "**/*_middleware.go"
    ],
    "test": [
      "**/*_test.go"
    ]
  }
}
