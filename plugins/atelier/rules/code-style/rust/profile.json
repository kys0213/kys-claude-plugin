{
  "roles": {
    "source": [
      "**/*.rs"
    ],
    "config": [
      "**/config.rs",
      "**/options.rs",
      "**/config/**/*.rs"
    ],
    "boundary": [
      "**/client.rs",
      "**/*_client.rs",
      "**/*_adapter.rs",
      "**/adapter/**/*.rs",
      "**/*_repository.rs",
      "**/*_handler.rs",
      "**/middleware.rs",
      "**/*_middleware.rs"
    ],
    "test": [
      "**/tests/**/*.rs",
      "**/tests.rs"
    ]
  }
}
