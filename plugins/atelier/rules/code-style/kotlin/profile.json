{
  "roles": {
    "source": [
      "**/*.kt"
    ],
    "config": [
      "**/*Config.kt",
      "**/*Configuration.kt",
      "**/*Properties.kt",
      "**/config/**/*.kt"
    ],
    "boundary": [
      "**/*Client.kt",
      "**/*Adapter.kt",
      "**/*Repository.kt",
      "**/*Controller.kt",
      "**/*Handler.kt",
      "**/*Interceptor.kt",
      "**/*Filter.kt",
      "**/*Middleware.kt"
    ],
    "test": [
      "**/src/test/**/*.kt",
      "**/*Test.kt",
      "**/*Tests.kt",
      "**/*IT.kt",
      "**/*Spec.kt"
    ]
  }
}
